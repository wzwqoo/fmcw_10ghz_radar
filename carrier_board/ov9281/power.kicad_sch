	(text "12 V input\n |\n |-- Buck 3V3, TPS54302 buck 3A\n |     |\n |     |-- RTL8211F DVDD33 / AVDD33 ~1A\n |     |-- INMP441 if using 3.3 V I2S logic ~2.2mA\n |     |-- CMOS oscillator / crystal oscillator module\n |     |-- NB3N551 clock buffer\n |     |-- TC358748 VDDIO if parallel bus is 3.3 V\n |     |\n |     |-- TPS74801 or quieter LDO --> 2V8_CAM_AVDD ~ 150mA each\n |     |\n |     |-- TPS74801 --> 1V8_CAM_IO\n |             |\n |             |-- OV9281 DOVDD ~ 150mA each\n |             |-- SN74LVC2G34 1V8\n |\n |-- Buck 1V2, 1 A to 2 A class\n       |\n       |-- OV9281 DVDD / EVDD ~300mA each cam\n       |-- TC358748 VDDC / VDD_MIPI ~100mA each TC358748\n       |\n       |-- optional ferrite beads / LC filters per camera and per bridge\n\n|-- RTL8211F internal regulator output --> RTL core 1.0 V only\n"
		(exclude_from_sim no)
		(at 298.704 46.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c9408cf7-5764-43c7-99e4-4781a863c704")
	)
	(text "1 nF  → roughly ~1.5 ms class startup\n10 nF → roughly ~15–18 ms startup"

	(text "Connect: Pins 10, 12, 29, 31 (Vcc) directly to a +5.0V Ultra-Low Noise LDO.\n\nDecoupling: Place a 4.7 µF capacitor and a 0.1 µF capacitor as close as possible to the Vcc pins."
		(exclude_from_sim no)
		(at 191.77 59.182 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1a1092e3-d6f1-423e-8b18-e0aab207d9ea")
	)
	(text "33 Ohms limits the slew rate slightly to avoid noise coupling into the sensitive ADC analog inputs."
		(exclude_from_sim no)
		(at 175.006 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1cc0683e-8146-479d-99da-129d5b4ce1b4")
	)
	(text "Place a 100pF - 1nF capacitor in series between the NB3N551 output (after the 33Ω resistor) and the ADF4159 REFIN. \nThis blocks the DC 1.65V bias from the buffer and protects the PLL input."
		(exclude_from_sim no)
		(at 197.612 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2942a354-71a1-42af-8445-b2431572b957")
	)
	(text "SN74LVC1G17"
		(exclude_from_sim no)
		(at 203.708 253.746 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2d05b375-c756-452a-aa41-2e182fe4d375")
	)
	(text "single-supply ≥15V capable, JFET/CMOS input, rail to rail if 15V supply\n"
		(exclude_from_sim no)
		(at 283.21 204.216 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "60e36f7e-2531-4ad9-bf29-65e88e472c5e")
	)
	(text "DVDD"
		(exclude_from_sim no)
		(at 77.978 66.802 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6802ade2-1f67-443a-983c-5ac611933df8")
	)
	(text "KT2520K 48Mhz: Generates a stable frequency but in a low-voltage Clipped Sine format.\nNC7S04P5X: Converts that low-voltage signal into a clean Square Wave (CMOS levels).\nNB3N551: Takes the clean square wave and distributes it to multiple components with minimal timing error (low skew)."
		(exclude_from_sim no)
		(at 59.182 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7a2fb934-4025-4ad7-8454-41b8d23a92d5")
	)
	(text "+11 dBm output"
		(exclude_from_sim no)
		(at 290.83 76.962 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
